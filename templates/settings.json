{
  "env": {
    "KIT_TEST_COMMAND": "{{TEST_CMD}}",
    "KIT_SOURCE_GLOB": "{{SOURCE_GLOB}}",
    "KIT_TEST_LOG_DIR": "{{TEST_LOG_DIR}}"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(swiftlint:*)",
      "Bash(xcodebuild -list:*)",
      "Bash(xcodebuild -showBuildSettings:*)",
      "Bash(xcrun simctl list:*)"
    ],
    "deny": [
      "Edit(**/*.xcodeproj/**)"
    ]
  }
}
